NODE_ENV=development
PORT=4000
# Where the dashboard runs; used for CORS and post-login redirects
FRONTEND_URL=http://localhost:3000
# Public URL of this API; used to build OAuth callback URLs
API_URL=http://localhost:4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachbox?schema=public
REDIS_URL=redis://localhost:6379
# Leave empty to disable Elasticsearch (search falls back to Postgres ILIKE)
ELASTICSEARCH_URL=http://localhost:9200

JWT_SECRET=change-me-to-a-long-random-string

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${API_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack OAuth (https://api.slack.com/apps) with the `incoming-webhook` scope
# Slack only allows https redirects: run a tunnel to :4000 and set SLACK_REDIRECT_URI=https://<tunnel>/api/slack/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# Allows POST /auth/dev-login for local testing without Google. Never enable in production.
ENABLE_DEV_LOGIN=true

# ---- Scheduler tuning ----
# Run the BullMQ worker inside the API process (handy locally). Set to false and run `npm run worker` separately to scale out.
RUN_WORKER_IN_API=true
WORKER_CONCURRENCY=5
# Global minimum gap between two SMTP sends, enforced by BullMQ's Redis-backed limiter
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard ceiling per sender per hour (a campaign's own hourly limit can only be lower)
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# ---- Email sending ----
# By default, the app creates Ethereal test accounts (test-only, emails won't be delivered).
# For production, configure a real SMTP provider below.

# SMTP_HOST=smtp.gmail.com          # Gmail, SendGrid, Mailgun, etc.
# SMTP_PORT=587                     # 587 for STARTTLS, 465 for SSL
# SMTP_SECURE=false                 # true for port 465, false for 587
# ETHEREAL_SENDERS=user:pass        # Your SMTP login, format: email:password (comma-separated for multiple)

# Popular SMTP providers:
#   Gmail:     smtp.gmail.com:587 (use App Password, not your regular password)
#   SendGrid:  smtp.sendgrid.net:587 (use SendGrid API key as password)
#   Mailgun:   smtp.mailgun.org:587
#   Outlook:   smtp-mail.outlook.com:587
#
# SENDER_COUNT controls how many Ethereal test accounts to create (ignored when SMTP_HOST is set)
SENDER_COUNT=3
ETHEREAL_SENDERS=
